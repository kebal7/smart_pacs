@{
    ViewData["Title"] = "Radiographer Portal";
}

<div class="container mt-4">

    <h2 class="text-center mb-4">Radiographer Portal</h2>

    <!-- Image Upload Section -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Upload / Acquire X-Ray</h5>

            <div class="mb-3">
                <input type="file" id="fileInput" class="form-control" accept="image/*">
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary" id="uploadImageBtn">Upload Image</button>
                <button class="btn btn-secondary" id="acquireBtn">Simulate X-Ray Acquisition</button>
            </div>
        </div>
    </div>

    <!-- Image Preview -->
    <div class="card mb-4">
        <div class="card-body text-center">
            <h5 class="card-title">Image Preview</h5>
            <img id="preview"
                 src=""
                 alt="No Image Loaded"
                 class="img-fluid border p-2"
                 style="max-width:300px;">
        </div>
    </div>

    <!-- Patient Info Section -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Patient Information</h5>

            <form id="patientForm">

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Patient ID</label>
                        <input type="text" id="patientId" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Accession No</label>
                        <input type="text" id="accessionNo" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Patient Name</label>
                        <input type="text" id="patientName" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Patient DOB</label>
                        <input type="text" id="patientDOB" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Patient Sex</label>
                        <select id="patientSex" class="form-select">
                            <option value="">Select</option>
                            <option value="M">Male</option>
                            <option value="F">Female</option>
                            <option value="O">Other</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Study Type</label>
                        <select id="studyType" class="form-select">
                            <option value="CR">X-Ray (CR)</option>
                            <option value="CT">CT</option>
                            <option value="MR">MRI</option>
                        </select>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-secondary" id="fillDummyBtn">
                        Fill Dummy Info
                    </button>
                    <button type="button" class="btn btn-success" id="uploadDicomBtn">
                        Upload to PACS
                    </button>
                    <button type="button" class="btn btn-outline-primary" id="downloadDicomBtn">
                        Download DICOM
                    </button>
                    <button type="button" class="btn btn-outline-danger" id="clearFieldsBtn">
                        Clear
                    </button>
                </div>

            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/radiographer-portal.js"></script>
}

